# ===== Misión Emprende — variables de entorno =====

# Desarrollo local: DJANGO_DEBUG=True usa SQLite y claves de desarrollo.
DJANGO_DEBUG=True

# Producción (obligatorias cuando DJANGO_DEBUG=False):
# DJANGO_SECRET_KEY=   # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# CLAVE_ADMIN=         # clave del panel de administración
# DJANGO_ALLOWED_HOSTS=misionemprende.udd.cl
# DJANGO_CSRF_TRUSTED=https://misionemprende.udd.cl

# Base de datos (producción con MySQL):
# DB_ENGINE=mysql
# DB_NAME=mision_emprende
# DB_USER=mision
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

